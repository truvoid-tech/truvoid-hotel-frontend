@page "/admin/institutions"
@rendermode InteractiveServer
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api

<AdminAuthGuard />
<PageTitle>TruvoID Admin — Institutions</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Institutions</h1>
            <p class="font-body-sm text-body-sm text-slate-gray mt-1">All registered institutions on the TruvoID platform</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant text-[18px] pointer-events-none">search</span>
                <input @bind="_search" @bind:event="oninput" type="text" placeholder="Search institutions..."
                       class="w-full md:w-56 border border-outline-variant rounded bg-paper-white pl-9 pr-4 py-2 font-body-sm text-body-sm text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy outline-none" />
            </div>
            <select @bind="_statusFilter"
                    class="border border-outline-variant rounded bg-paper-white px-3 py-2 font-body-sm text-body-sm text-on-surface focus:ring-1 focus:ring-deep-navy outline-none">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Pending">Pending</option>
                <option value="Suspended">Suspended</option>
            </select>
        </div>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else
    {
        <!-- Stats strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-gutter">
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg text-primary font-bold">@_institutions.Count</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Total</p>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg font-bold" style="color:#137333">@_institutions.Count(i => i.Status == "Active")</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Active</p>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg text-[#b06000] font-bold">@_institutions.Count(i => i.Status == "Pending")</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Pending</p>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg text-error font-bold">@_institutions.Count(i => i.Status == "Suspended")</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Suspended</p>
            </div>
        </div>

        <!-- Table -->
        <div class="bg-paper-white border border-outline-variant rounded overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[780px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Institution</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Wallet Balance</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Tokens</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">API Calls (MTD)</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Joined</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inst in FilteredInstitutions)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-label-md text-label-md text-on-surface">@inst.Name</p>
                                    <p class="font-body-sm text-[11px] text-slate-gray">@inst.Email</p>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-label-sm text-label-sm @StatusClass(inst.Status)">
                                        <span class="w-1.5 h-1.5 rounded-full @StatusDot(inst.Status)"></span>
                                        @inst.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-label-md text-label-md text-deep-navy">&#8358;@inst.WalletBalance.ToString("N0")</td>
                                <td class="px-6 py-4 font-label-md text-label-md text-warm-gold">@inst.Tokens.ToString("N0")</td>
                                <td class="px-6 py-4 font-body-md text-body-md text-on-surface">@inst.ApiCallsMtd.ToString("N0")</td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@inst.JoinedDate.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <button class="font-label-sm text-label-sm text-deep-navy hover:underline uppercase">View</button>
                                        <span class="text-outline-variant">·</span>
                                        <button @onclick="() => OpenRecordPayment(inst)" class="font-label-sm text-label-sm text-warm-gold hover:underline uppercase">Record Payment</button>
                                        @if (inst.Status == "Active")
                                        {
                                            <span class="text-outline-variant">·</span>
                                            <button @onclick="() => SuspendInstitution(inst)" class="font-label-sm text-label-sm text-error hover:underline uppercase">Suspend</button>
                                        }
                                        else if (inst.Status == "Suspended")
                                        {
                                            <span class="text-outline-variant">·</span>
                                            <button @onclick="() => ReactivateInstitution(inst)" class="font-label-sm text-label-sm text-[#137333] hover:underline uppercase">Reactivate</button>
                                        }
                                        else if (inst.Status == "Pending")
                                        {
                                            <span class="text-outline-variant">·</span>
                                            <button @onclick="() => ApproveInstitution(inst)" class="font-label-sm text-label-sm text-[#137333] hover:underline uppercase">Approve</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!FilteredInstitutions.Any())
            {
                <div class="py-16 text-center">
                    <span class="material-symbols-outlined text-[40px] text-outline-variant mb-3 block">search_off</span>
                    <p class="font-body-md text-body-md text-slate-gray">No institutions match your filters.</p>
                </div>
            }
        </div>
    }

    @if (_paymentTarget is not null)
    {
        <div class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 px-4">
            <div class="bg-paper-white rounded-lg border border-outline-variant shadow-lg w-full max-w-md p-6">
                <h3 class="font-headline-md text-headline-md text-on-surface mb-1">Record Manual Payment</h3>
                <p class="font-body-sm text-body-sm text-slate-gray mb-4">@_paymentTarget.Name</p>

                @if (!string.IsNullOrEmpty(_paymentError))
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">@_paymentError</div>
                }

                <label class="block font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-2">Amount Paid (&#8358;)</label>
                <input @bind="_paymentAmount" @bind:event="oninput" type="number" min="1" step="100"
                       class="w-full border border-outline-variant rounded px-3 py-2 font-body-md text-body-md text-on-surface focus:ring-1 focus:ring-deep-navy outline-none mb-3" />

                <label class="block font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-2">Description (optional)</label>
                <input @bind="_paymentDescription" type="text" placeholder="e.g. Bank transfer ref #12345"
                       class="w-full border border-outline-variant rounded px-3 py-2 font-body-md text-body-md text-on-surface focus:ring-1 focus:ring-deep-navy outline-none mb-4" />

                <div class="bg-surface-container-low border border-surface-variant rounded p-3 mb-6">
                    <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Tokens to allot</p>
                    <p class="font-headline-md text-headline-md text-warm-gold font-bold">&#8776; @(PaymentTokens.ToString("N0")) tokens</p>
                </div>

                <div class="flex justify-end gap-3">
                    <button @onclick="CloseRecordPayment" disabled="@_paymentSubmitting" class="px-4 py-2 border border-outline-variant text-on-surface font-label-sm text-label-sm uppercase rounded hover:bg-surface-container-low transition-colors">Cancel</button>
                    <button @onclick="SubmitRecordPayment" disabled="@(_paymentSubmitting || _paymentAmount <= 0)" class="px-4 py-2 bg-warm-gold text-paper-white font-label-sm text-label-sm uppercase rounded hover:opacity-90 transition-opacity disabled:opacity-50">
                        @(_paymentSubmitting ? "Recording..." : "Record Payment")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private bool _loading = true;
    private List<AdminInstitutionDto> _institutions = [];

    private const decimal NairaPerToken = 10m;
    private AdminInstitutionDto? _paymentTarget;
    private decimal _paymentAmount = 10000;
    private string _paymentDescription = string.Empty;
    private string? _paymentError;
    private bool _paymentSubmitting;

    private decimal PaymentTokens => Math.Floor(_paymentAmount / NairaPerToken);

    private void OpenRecordPayment(AdminInstitutionDto inst)
    {
        _paymentTarget = inst;
        _paymentAmount = 10000;
        _paymentDescription = string.Empty;
        _paymentError = null;
    }

    private void CloseRecordPayment()
    {
        _paymentTarget = null;
    }

    private async Task SubmitRecordPayment()
    {
        if (_paymentTarget is null || _paymentAmount <= 0) return;

        _paymentSubmitting = true;
        _paymentError = null;

        try
        {
            await Api.PostAsync($"/v1/admin/wallets/{_paymentTarget.Id}/credit", new
            {
                amount = _paymentAmount,
                description = string.IsNullOrWhiteSpace(_paymentDescription) ? "Manual payment" : _paymentDescription
            });

            var idx = _institutions.IndexOf(_paymentTarget);
            if (idx >= 0)
            {
                var updated = _institutions[idx];
                _institutions[idx] = updated with
                {
                    WalletBalance = updated.WalletBalance + _paymentAmount,
                    Tokens = updated.Tokens + PaymentTokens
                };
            }

            _paymentTarget = null;
        }
        catch (Exception)
        {
            _paymentError = "Unable to record payment. Please try again.";
        }
        finally
        {
            _paymentSubmitting = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var result = await Api.GetAsync<List<AdminInstitutionDto>>("/v1/admin/institutions");
            _institutions = result ?? [];
        }
        catch
        {
            // Fallback to empty list on error
            _institutions = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<AdminInstitutionDto> FilteredInstitutions => _institutions
        .Where(i => (string.IsNullOrEmpty(_search) || i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))
                 && (string.IsNullOrEmpty(_statusFilter) || i.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase)));

    private static string StatusClass(string status) => status switch
    {
        "Active"    => "bg-[#e6f4ea] text-[#137333] border border-[#ceead6]",
        "Pending"   => "bg-[#fef7e0] text-[#b06000] border border-[#fde083]",
        "Suspended" => "bg-[#fce8e6] text-[#c5221f] border border-[#f5c6c4]",
        _           => "bg-surface-container text-slate-gray border border-outline-variant"
    };

    private static string StatusDot(string status) => status switch
    {
        "Active"    => "bg-[#34a853]",
        "Pending"   => "bg-[#f9ab00]",
        "Suspended" => "bg-[#ea4335]",
        _           => "bg-slate-gray"
    };

    private async Task SuspendInstitution(AdminInstitutionDto inst)
    {
        await Api.PostAsync($"/v1/admin/institutions/{inst.Id}/suspend", new { });
        var idx = _institutions.IndexOf(inst);
        if (idx >= 0) _institutions[idx] = inst with { Status = "Suspended" };
    }

    private async Task ReactivateInstitution(AdminInstitutionDto inst)
    {
        await Api.PostAsync($"/v1/admin/institutions/{inst.Id}/reactivate", new { });
        var idx = _institutions.IndexOf(inst);
        if (idx >= 0) _institutions[idx] = inst with { Status = "Active" };
    }

    private async Task ApproveInstitution(AdminInstitutionDto inst)
    {
        await Api.PostAsync($"/v1/admin/institutions/{inst.Id}/approve", new { });
        var idx = _institutions.IndexOf(inst);
        if (idx >= 0) _institutions[idx] = inst with { Status = "Active" };
    }
}
