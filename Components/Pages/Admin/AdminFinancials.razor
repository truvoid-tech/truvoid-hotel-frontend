@page "/admin/financials"
@rendermode InteractiveServer
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api

<AdminAuthGuard />
<PageTitle>TruvoID Admin — Financials</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Platform Financials</h1>
            <p class="font-body-sm text-body-sm text-slate-gray mt-1">Revenue, cost payouts, and wallet top-up approvals</p>
        </div>
        <div class="flex items-center gap-2">
            <select @bind="_period"
                    class="border border-outline-variant rounded bg-paper-white px-3 py-2 font-body-sm text-body-sm text-on-surface focus:ring-1 focus:ring-deep-navy outline-none">
                <option value="mtd">This Month</option>
                <option value="last">Last Month</option>
                <option value="q">This Quarter</option>
                <option value="ytd">Year to Date</option>
            </select>
        </div>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else if (_financials is not null)
    {
        <!-- Revenue Summary -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter">
            <div class="bg-paper-white border-t-[3px] border-t-warm-gold border-x border-b border-outline-variant rounded shadow-sm p-5">
                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-2">Gross Revenue</p>
                <p class="font-display-lg text-display-lg text-primary font-bold">₦@_financials.GrossRevenue.ToString("N0")</p>
                <p class="font-body-sm text-[11px] text-slate-gray mt-1">@_financials.TotalCalls.ToString("N0") calls</p>
            </div>
            <div class="bg-paper-white border-t-[3px] border-t-error border-x border-b border-outline-variant rounded shadow-sm p-5">
                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-2">NIMC Payouts</p>
                <p class="font-display-lg text-display-lg text-error font-bold">₦@_financials.NimcPayouts.ToString("N0")</p>
                <p class="font-body-sm text-[11px] text-slate-gray mt-1">API call costs</p>
            </div>
            <div class="bg-paper-white border-t-[3px] border-t-deep-navy border-x border-b border-outline-variant rounded shadow-sm p-5">
                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider mb-2">Net Profit</p>
                <p class="font-display-lg text-display-lg text-primary font-bold">₦@_financials.NetProfit.ToString("N0")</p>
                <p class="font-body-sm text-[11px] text-[#137333] mt-1">@_financials.MarginPct% margin</p>
            </div>
        </div>

        <!-- Pending Top-Up Approvals -->
        <div class="bg-paper-white border border-outline-variant rounded overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-outline-variant">
                <div class="flex items-center gap-3">
                    <h2 class="font-label-md text-label-md uppercase text-on-surface">Pending Top-Up Approvals</h2>
                    <span class="bg-[#fef7e0] border border-[#fde083] text-[#b06000] font-label-sm text-label-sm rounded-full px-2.5 py-0.5">@_financials.PendingTopUps.Count Pending</span>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[680px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Institution</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Amount</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Reference</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Submitted</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var topup in _financials.PendingTopUps)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-label-md text-label-md text-on-surface">@topup.Institution</p>
                                    <p class="font-body-sm text-[11px] text-slate-gray">@topup.Email</p>
                                </td>
                                <td class="px-6 py-4 font-label-md text-label-md text-deep-navy">₦@topup.Amount.ToString("N0")</td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-on-surface font-mono">@topup.Reference</td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@topup.Submitted</td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <button @onclick="() => ApproveTopUp(topup)" class="inline-flex items-center gap-1 bg-[#e6f4ea] border border-[#ceead6] text-[#137333] hover:bg-[#ceead6] transition-colors font-label-sm text-label-sm px-3 py-1.5 rounded uppercase">
                                            <span class="material-symbols-outlined text-[14px]">check</span>
                                            Approve
                                        </button>
                                        <button @onclick="() => RejectTopUp(topup)" class="inline-flex items-center gap-1 bg-[#fce8e6] border border-[#f5c6c4] text-[#c5221f] hover:bg-[#f5c6c4] transition-colors font-label-sm text-label-sm px-3 py-1.5 rounded uppercase">
                                            <span class="material-symbols-outlined text-[14px]">close</span>
                                            Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!_financials.PendingTopUps.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center font-body-sm text-body-sm text-slate-gray">No pending top-ups.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Platform Transaction Log -->
        <div class="bg-paper-white border border-outline-variant rounded overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-outline-variant">
                <h2 class="font-label-md text-label-md uppercase text-on-surface">Platform Transaction Log</h2>
                <div class="flex items-center gap-2">
                    <select @bind="_txFilter"
                            class="border border-outline-variant rounded bg-paper-white px-2 py-1.5 font-label-sm text-label-sm text-on-surface focus:ring-1 focus:ring-deep-navy outline-none text-[11px]">
                        <option value="">All Types</option>
                        <option value="topup">Wallet Top-Ups</option>
                        <option value="api">API Calls</option>
                    </select>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full min-w-[700px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Reference</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Institution</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Type</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Amount</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in FilteredTransactions)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4 font-body-sm text-body-sm text-on-surface font-mono">@tx.Reference</td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-on-surface">@tx.Institution</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1 rounded px-2 py-1 font-label-sm text-label-sm @(tx.Type == "Wallet Top-Up" ? "bg-[#e6f4ea] text-[#137333] border border-[#ceead6]" : "bg-surface-container border border-outline-variant text-slate-gray")">
                                        @tx.Type
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-label-md text-label-md @(tx.Amount > 0 ? "text-[#137333]" : "text-error")">
                                    @(tx.Amount > 0 ? "+" : "")₦@Math.Abs(tx.Amount).ToString("N2")
                                </td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@tx.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private string _period = "mtd";
    private string _txFilter = string.Empty;
    private bool _loading = true;
    private AdminFinancialsDto? _financials;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _financials = await Api.GetAsync<AdminFinancialsDto>("/v1/admin/financials");
        }
        catch
        {
            _financials = new AdminFinancialsDto();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<AdminTransactionDto> FilteredTransactions =>
        _financials?.Transactions.Where(t => _txFilter switch
        {
            "topup" => t.Type == "Wallet Top-Up",
            "api"   => t.Type == "API Call",
            _       => true
        }) ?? [];

    private async Task ApproveTopUp(AdminTopUpDto topup)
    {
        await Api.PostAsync($"/v1/admin/topups/{topup.Id}/approve", new { });
        if (_financials is not null)
        {
            _financials = _financials with { PendingTopUps = [.. _financials.PendingTopUps.Where(t => t.Id != topup.Id)] };
        }
    }

    private async Task RejectTopUp(AdminTopUpDto topup)
    {
        await Api.PostAsync($"/v1/admin/topups/{topup.Id}/reject", new { });
        if (_financials is not null)
        {
            _financials = _financials with { PendingTopUps = [.. _financials.PendingTopUps.Where(t => t.Id != topup.Id)] };
        }
    }
}
