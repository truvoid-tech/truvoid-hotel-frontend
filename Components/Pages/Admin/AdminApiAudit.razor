@page "/admin/api-audit"
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api

<AdminAuthGuard />
<PageTitle>TruvoID Admin — API Audit</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">API Key Audit</h1>
            <p class="font-body-sm text-body-sm text-slate-gray mt-1">All API keys across every institution — monitor usage, revoke suspicious keys</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant text-[18px] pointer-events-none">search</span>
                <input @bind="_search" @bind:event="oninput" type="text" placeholder="Search institution or key..."
                       class="w-full md:w-56 border border-outline-variant rounded bg-paper-white pl-9 pr-4 py-2 font-body-sm text-body-sm text-on-background focus:ring-1 focus:ring-deep-navy focus:border-deep-navy outline-none" />
            </div>
            <select @bind="_statusFilter"
                    class="border border-outline-variant rounded bg-paper-white px-3 py-2 font-body-sm text-body-sm text-on-surface focus:ring-1 focus:ring-deep-navy outline-none">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Revoked">Revoked</option>
            </select>
        </div>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else
    {
        <!-- Summary strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-gutter">
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg text-primary font-bold">@_keys.Count</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Total Keys</p>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg font-bold" style="color:#137333">@_keys.Count(k => k.Status == "Active")</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Active</p>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg text-error font-bold">@_keys.Count(k => k.Status == "Revoked")</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Revoked</p>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-4 text-center">
                <p class="font-display-lg text-display-lg text-primary font-bold">@_keys.Sum(k => k.CallCount).ToString("N0")</p>
                <p class="font-label-sm text-label-sm text-slate-gray uppercase mt-1">Total Calls</p>
            </div>
        </div>

        <!-- Table -->
        <div class="bg-paper-white border border-outline-variant rounded overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[820px]">
                    <thead class="bg-surface-container-low border-b border-outline-variant">
                        <tr>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Institution</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Key Prefix</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Description</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Total Calls</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Last Used</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Created</th>
                            <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in FilteredKeys)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4 font-label-md text-label-md text-on-surface">@key.InstitutionName</td>
                                <td class="px-6 py-4 font-mono text-body-sm text-on-surface">
                                    <span class="bg-surface-container-low border border-outline-variant rounded px-2 py-0.5">@(key.KeyPrefix)...</span>
                                </td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@(key.Description ?? "—")</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-label-sm text-label-sm
                                        @(key.Status == "Active"
                                            ? "bg-[#e6f4ea] text-[#137333] border border-[#ceead6]"
                                            : "bg-[#fce8e6] text-[#c5221f] border border-[#f5c6c4]")">
                                        <span class="w-1.5 h-1.5 rounded-full @(key.Status == "Active" ? "bg-[#34a853]" : "bg-[#ea4335]")"></span>
                                        @key.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-body-md text-body-md text-on-surface">@key.CallCount.ToString("N0")</td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">
                                    @(key.LastUsedAt.HasValue ? key.LastUsedAt.Value.ToString("dd MMM yyyy, HH:mm") : "Never")
                                </td>
                                <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@key.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4">
                                    @if (key.Status == "Active")
                                    {
                                        <button @onclick="() => RevokeKey(key)"
                                                class="inline-flex items-center gap-1 bg-[#fce8e6] border border-[#f5c6c4] text-[#c5221f] hover:bg-[#f5c6c4] transition-colors font-label-sm text-label-sm px-3 py-1.5 rounded uppercase">
                                            <span class="material-symbols-outlined text-[14px]">block</span>
                                            Revoke
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="font-label-sm text-label-sm text-slate-gray uppercase">Revoked</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!FilteredKeys.Any())
            {
                <div class="py-16 text-center">
                    <span class="material-symbols-outlined text-[40px] text-outline-variant mb-3 block">key_off</span>
                    <p class="font-body-md text-body-md text-slate-gray">No API keys match your filters.</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private List<AdminApiKeyDto> _keys = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetAsync<List<AdminApiKeyDto>>("/v1/admin/api-keys");
            _keys = result ?? [];
        }
        catch
        {
            _keys = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<AdminApiKeyDto> FilteredKeys => _keys
        .Where(k =>
            (string.IsNullOrEmpty(_search) ||
             k.InstitutionName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             k.KeyPrefix.Contains(_search, StringComparison.OrdinalIgnoreCase))
         && (string.IsNullOrEmpty(_statusFilter) || k.Status == _statusFilter));

    private async Task RevokeKey(AdminApiKeyDto key)
    {
        await Api.PostAsync($"/v1/admin/api-keys/{key.Id}/revoke", new { });
        var idx = _keys.IndexOf(key);
        if (idx >= 0)
            _keys[idx] = new AdminApiKeyDto
            {
                Id = key.Id,
                InstitutionName = key.InstitutionName,
                KeyPrefix = key.KeyPrefix,
                Description = key.Description,
                Status = "Revoked",
                CallCount = key.CallCount,
                CreatedAt = key.CreatedAt,
                LastUsedAt = key.LastUsedAt
            };
    }
}
