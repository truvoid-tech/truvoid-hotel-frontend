@page "/admin/audit"
@rendermode InteractiveServer
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api

<AdminAuthGuard />
<PageTitle>TruvoID — Activity Log</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Activity Log</h1>
        <p class="font-body-sm text-body-sm text-slate-gray mt-1">Audit trail of all platform admin actions</p>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else if (_entries.Any())
    {
        <div class="bg-paper-white border border-outline-variant rounded-xl overflow-hidden">
            <table class="w-full">
                <thead class="bg-surface-container-low border-b border-outline-variant">
                    <tr>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Time</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Actor</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Action</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Entity</th>
                        <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var entry in _entries)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-body-sm text-body-sm text-on-surface">@entry.CreatedAt.ToString("dd MMM yyyy")</div>
                                <div class="font-label-sm text-label-sm text-slate-gray">@entry.CreatedAt.ToString("HH:mm:ss")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-body-sm text-body-sm text-on-surface">@(entry.ActorEmail ?? entry.ActorType)</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded font-label-sm text-label-sm @GetActionStyle(entry.Action)">
                                    @entry.Action
                                </span>
                            </td>
                            <td class="px-6 py-4 font-body-sm text-body-sm text-slate-gray">@entry.Entity</td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(entry.DetailsJson))
                                {
                                    <span class="font-label-sm text-label-sm text-slate-gray bg-surface-container px-2 py-1 rounded max-w-[200px] truncate block">@entry.DetailsJson</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between">
            <span class="font-body-sm text-body-sm text-slate-gray">Showing @_entries.Count entries</span>
            <div class="flex gap-2">
                @if (_page > 1)
                {
                    <button @onclick="PrevPage" class="border border-outline-variant rounded px-4 py-2 font-label-sm text-label-sm hover:bg-surface-container-low">Previous</button>
                }
                <button @onclick="NextPage" class="border border-outline-variant rounded px-4 py-2 font-label-sm text-label-sm hover:bg-surface-container-low">Next</button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-paper-white border border-outline-variant rounded-xl p-12 text-center">
            <span class="material-symbols-outlined text-slate-gray text-[48px]">history</span>
            <p class="font-body-sm text-body-sm text-slate-gray mt-4">No activity logged yet</p>
        </div>
    }
</div>

@code {
    private List<AuditLogEntryDto> _entries = [];
    private bool _loading = true;
    private int _page = 1;
    private const int PageSize = 50;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _entries = await Api.GetAsync<List<AuditLogEntryDto>>($"/v1/admin/audit?page={_page}&pageSize={PageSize}") ?? [];
        }
        catch { }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task PrevPage()
    {
        _page--;
        await LoadEntries();
    }

    private async Task NextPage()
    {
        _page++;
        await LoadEntries();
    }

    private string GetActionStyle(string action) => action switch
    {
        "Created" => "bg-green-50 text-green-700 border border-green-200",
        "Updated" => "bg-blue-50 text-blue-700 border border-blue-200",
        "Deleted" => "bg-red-50 text-red-700 border border-red-200",
        "Login" => "bg-surface-container text-slate-gray border border-outline-variant",
        "Verified" => "bg-green-50 text-green-700 border border-green-200",
        _ => "bg-surface-container text-slate-gray border border-outline-variant"
    };
}
