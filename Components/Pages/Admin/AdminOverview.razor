@page "/admin"
@layout AdminLayout
@namespace TruvoID.Components.AdminPages
@inject ApiClient Api

<AdminAuthGuard />
<PageTitle>TruvoID — Platform Admin</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-10 flex-1 flex flex-col gap-section-gap">

    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Platform Overview</h1>
            <p class="font-body-sm text-body-sm text-slate-gray mt-1">Live platform metrics</p>
        </div>
        <div class="flex items-center gap-2 bg-surface-container-low border border-outline-variant rounded px-3 py-1.5">
            <span class="w-2 h-2 rounded-full bg-[#34a853] inline-block animate-pulse"></span>
            <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Live</span>
        </div>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
            <span class="ml-3 font-body-sm text-body-sm text-slate-gray">Loading platform data...</span>
        </div>
    }
    else if (_error is not null)
    {
        <div class="flex items-center gap-3 p-4 bg-[#fce8e6] border border-[#f5c6c4] rounded text-[#c5221f]">
            <span class="material-symbols-outlined text-[18px]">error</span>
            <span class="font-body-sm text-body-sm">@_error</span>
        </div>
    }
    else if (_overview is not null)
    {
        <!-- KPI Cards Row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter">
            <!-- Total Revenue (MTD) -->
            <div class="bg-paper-white border-t-[3px] border-t-warm-gold border-x border-b border-outline-variant rounded shadow-sm p-5 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Revenue (MTD)</span>
                    <span class="material-symbols-outlined text-warm-gold text-[20px]" style="font-variation-settings: 'FILL' 1;">trending_up</span>
                </div>
                <p class="font-display-lg text-display-lg text-primary font-bold leading-none">₦@_overview.RevenueMtd.ToString("N0")</p>
                <div class="flex items-center gap-1 text-[#34a853]">
                    <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
                    <span class="font-label-sm text-label-sm">+@_overview.RevenueGrowthPct% vs last month</span>
                </div>
            </div>

            <!-- Platform Costs (MTD) -->
            <div class="bg-paper-white border-t-[3px] border-t-error border-x border-b border-outline-variant rounded shadow-sm p-5 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">NIMC Costs (MTD)</span>
                    <span class="material-symbols-outlined text-error text-[20px]" style="font-variation-settings: 'FILL' 1;">receipt_long</span>
                </div>
                <p class="font-display-lg text-display-lg text-error font-bold leading-none">₦@_overview.CostsMtd.ToString("N0")</p>
                <div class="flex items-center gap-1 text-slate-gray">
                    <span class="material-symbols-outlined text-[13px]">remove</span>
                    <span class="font-label-sm text-label-sm">API call payouts</span>
                </div>
            </div>

            <!-- Net Margin -->
            <div class="bg-paper-white border-t-[3px] border-t-deep-navy border-x border-b border-outline-variant rounded shadow-sm p-5 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Net Margin</span>
                    <span class="material-symbols-outlined text-deep-navy text-[20px]" style="font-variation-settings: 'FILL' 1;">savings</span>
                </div>
                <p class="font-display-lg text-display-lg text-primary font-bold leading-none">₦@_overview.NetMargin.ToString("N0")</p>
                <div class="flex items-center gap-1 text-[#34a853]">
                    <span class="material-symbols-outlined text-[13px]">percent</span>
                    <span class="font-label-sm text-label-sm">@(_overview.RevenueMtd > 0 ? Math.Round(_overview.NetMargin / _overview.RevenueMtd * 100, 1) : 0)% margin</span>
                </div>
            </div>

            <!-- Active Institutions -->
            <div class="bg-paper-white border-t-[3px] border-t-slate-gray border-x border-b border-outline-variant rounded shadow-sm p-5 flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Active Institutions</span>
                    <span class="material-symbols-outlined text-slate-gray text-[20px]" style="font-variation-settings: 'FILL' 1;">corporate_fare</span>
                </div>
                <p class="font-display-lg text-display-lg text-primary font-bold leading-none">@_overview.ActiveInstitutions</p>
                <div class="flex items-center gap-1 text-[#34a853]">
                    <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
                    <span class="font-label-sm text-label-sm">+@_overview.NewInstitutionsThisMonth this month</span>
                </div>
            </div>
        </div>

        <!-- Secondary Metrics Row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter">
            <div class="bg-paper-white border border-outline-variant rounded p-5 flex items-center gap-4">
                <div class="w-10 h-10 rounded bg-surface-container-low flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-deep-navy text-[20px]" style="font-variation-settings: 'FILL' 1;">fact_check</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Total API Calls (MTD)</p>
                    <p class="font-headline-lg text-headline-lg text-on-surface font-bold">@_overview.TotalApiCallsMtd.ToString("N0")</p>
                </div>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-5 flex items-center gap-4">
                <div class="w-10 h-10 rounded bg-surface-container-low flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-deep-navy text-[20px]" style="font-variation-settings: 'FILL' 1;">account_balance_wallet</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Total Wallet Balances</p>
                    <p class="font-headline-lg text-headline-lg text-on-surface font-bold">₦@_overview.TotalWalletBalances.ToString("N0")</p>
                </div>
            </div>
            <div class="bg-paper-white border border-outline-variant rounded p-5 flex items-center gap-4">
                <div class="w-10 h-10 rounded bg-surface-container-low flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[#b06000] text-[20px]" style="font-variation-settings: 'FILL' 1;">pending_actions</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Pending Top-Up Approvals</p>
                    <p class="font-headline-lg text-headline-lg text-on-surface font-bold">@_overview.PendingTopUpApprovals</p>
                </div>
            </div>
        </div>

        <!-- Two column lower section -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">

            <!-- Top Institutions by Volume -->
            <div class="lg:col-span-8 bg-paper-white border border-outline-variant rounded overflow-hidden">
                <div class="flex items-center justify-between px-6 py-4 border-b border-outline-variant">
                    <h2 class="font-label-md text-label-md uppercase text-on-surface">Top Institutions by Volume</h2>
                    <a href="/admin/institutions" class="font-label-sm text-label-sm text-deep-navy hover:text-warm-gold transition-colors uppercase tracking-wider">View All</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[500px]">
                        <thead class="bg-surface-container-low border-b border-outline-variant">
                            <tr>
                                <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Institution</th>
                                <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Calls (MTD)</th>
                                <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Revenue</th>
                                <th class="text-left px-6 py-3 font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inst in _overview.TopInstitutions)
                            {
                                <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors">
                                    <td class="px-6 py-4">
                                        <p class="font-label-md text-label-md text-on-surface">@inst.Name</p>
                                        <p class="font-body-sm text-[10px] text-slate-gray">@inst.Email</p>
                                    </td>
                                    <td class="px-6 py-4 font-body-md text-body-md text-on-surface">@inst.CallsMtd.ToString("N0")</td>
                                    <td class="px-6 py-4 font-label-md text-label-md text-deep-navy">₦@inst.RevenueMtd.ToString("N0")</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center gap-1 rounded px-2 py-1 font-label-sm text-label-sm @(inst.Active ? "bg-[#e6f4ea] text-[#137333] border border-[#ceead6]" : "bg-surface-container border border-outline-variant text-slate-gray")">
                                            @(inst.Active ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (!_overview.TopInstitutions.Any())
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-8 text-center font-body-sm text-body-sm text-slate-gray">No institutions found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- API Call Breakdown + Quick Actions -->
            <div class="lg:col-span-4 flex flex-col gap-gutter">
                <div class="bg-paper-white border border-outline-variant rounded p-6 flex flex-col gap-4">
                    <h2 class="font-label-md text-label-md uppercase text-on-surface border-b border-outline-variant pb-3">API Call Breakdown</h2>
                    @{
                        var total = _overview.CallBreakdown.Total;
                    }
                    <div class="flex flex-col gap-3">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-label-sm text-label-sm text-slate-gray uppercase">NIN</span>
                                <span class="font-label-sm text-label-sm text-on-surface font-semibold">@_overview.CallBreakdown.NinCalls.ToString("N0") <span class="text-slate-gray font-normal">(@(total > 0 ? Math.Round((double)_overview.CallBreakdown.NinCalls / total * 100) : 0)%)</span></span>
                            </div>
                            <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden">
                                <div class="h-full bg-deep-navy rounded-full" style="width:@(total > 0 ? Math.Round((double)_overview.CallBreakdown.NinCalls / total * 100) : 0)%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-label-sm text-label-sm text-slate-gray uppercase">BVN</span>
                                <span class="font-label-sm text-label-sm text-on-surface font-semibold">@_overview.CallBreakdown.BvnCalls.ToString("N0") <span class="text-slate-gray font-normal">(@(total > 0 ? Math.Round((double)_overview.CallBreakdown.BvnCalls / total * 100) : 0)%)</span></span>
                            </div>
                            <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden">
                                <div class="h-full bg-warm-gold rounded-full" style="width:@(total > 0 ? Math.Round((double)_overview.CallBreakdown.BvnCalls / total * 100) : 0)%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-label-sm text-label-sm text-slate-gray uppercase">Phone</span>
                                <span class="font-label-sm text-label-sm text-on-surface font-semibold">@_overview.CallBreakdown.PhoneCalls.ToString("N0") <span class="text-slate-gray font-normal">(@(total > 0 ? Math.Round((double)_overview.CallBreakdown.PhoneCalls / total * 100) : 0)%)</span></span>
                            </div>
                            <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden">
                                <div class="h-full bg-slate-gray rounded-full" style="width:@(total > 0 ? Math.Round((double)_overview.CallBreakdown.PhoneCalls / total * 100) : 0)%"></div>
                            </div>
                        </div>
                    </div>
                    <a href="/admin/pricing" class="mt-1 flex items-center gap-1 font-label-sm text-label-sm text-deep-navy hover:text-warm-gold transition-colors uppercase">
                        <span class="material-symbols-outlined text-[14px]">price_change</span>
                        Manage Pricing
                    </a>
                </div>

                <div class="bg-paper-white border border-outline-variant rounded p-6 flex flex-col gap-3">
                    <h2 class="font-label-md text-label-md uppercase text-on-surface border-b border-outline-variant pb-3">Quick Actions</h2>
                    <a href="/admin/financials" class="flex items-center gap-3 p-3 rounded border border-outline-variant hover:border-deep-navy hover:bg-surface-container-low transition-colors group">
                        <span class="material-symbols-outlined text-deep-navy text-[20px]">pending_actions</span>
                        <div>
                            <p class="font-label-md text-label-md text-on-surface">Top-Up Approvals</p>
                            <p class="font-body-sm text-[11px] text-slate-gray">@_overview.PendingTopUpApprovals pending review</p>
                        </div>
                        <span class="material-symbols-outlined text-slate-gray ml-auto group-hover:text-deep-navy transition-colors text-[16px]">chevron_right</span>
                    </a>
                    <a href="/admin/institutions" class="flex items-center gap-3 p-3 rounded border border-outline-variant hover:border-deep-navy hover:bg-surface-container-low transition-colors group">
                        <span class="material-symbols-outlined text-deep-navy text-[20px]">person_add</span>
                        <div>
                            <p class="font-label-md text-label-md text-on-surface">New Institutions</p>
                            <p class="font-body-sm text-[11px] text-slate-gray">@_overview.PendingInstitutions pending onboarding</p>
                        </div>
                        <span class="material-symbols-outlined text-slate-gray ml-auto group-hover:text-deep-navy transition-colors text-[16px]">chevron_right</span>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AdminOverviewDto? _overview;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _overview = await Api.GetAsync<AdminOverviewDto>("/v1/admin/overview");
        }
        catch (Exception ex)
        {
            _error = $"Failed to load platform data: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
