@page "/notifications"
@layout DashboardLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav

<AuthGuard />
<PageTitle>TruvoID — Notifications</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1 flex flex-col gap-section-gap max-w-[960px] mx-auto w-full">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Notifications</h1>
            <p class="font-body-sm text-body-sm text-slate-gray mt-1">Stay updated on your account activity and alerts.</p>
        </div>
        @if (_notifications.Any(n => !n.IsRead))
        {
            <button @onclick="MarkAllRead" disabled="@_markingAll"
                    class="font-label-sm text-label-sm text-primary hover:text-deep-navy transition-colors uppercase disabled:opacity-50">
                @(_markingAll ? "Marking..." : "Mark all read")
            </button>
        }
    </div>

    <!-- Filter Tabs -->
    <div class="flex gap-2 flex-wrap">
        <button @onclick="() => _filter = FAll" class="px-4 py-2 rounded-full font-label-sm text-label-sm transition-colors @(_filter == FAll ? "bg-deep-navy text-paper-white" : "bg-surface-container-low border border-outline-variant text-slate-gray hover:text-deep-navy")">All</button>
        <button @onclick="() => _filter = FUnread" class="px-4 py-2 rounded-full font-label-sm text-label-sm transition-colors @(_filter == FUnread ? "bg-deep-navy text-paper-white" : "bg-surface-container-low border border-outline-variant text-slate-gray hover:text-deep-navy")">
            Unread
            @if (_notifications.Any(n => !n.IsRead))
            {
                <span class="ml-1.5 inline-flex items-center justify-center min-w-[18px] h-[18px] bg-primary text-on-primary text-[10px] font-bold rounded-full px-1">@_notifications.Count(n => !n.IsRead)</span>
            }
        </button>
        <button @onclick="() => _filter = FLowBalance" class="px-4 py-2 rounded-full font-label-sm text-label-sm transition-colors @(_filter == FLowBalance ? "bg-deep-navy text-paper-white" : "bg-surface-container-low border border-outline-variant text-slate-gray hover:text-deep-navy")">Balance</button>
        <button @onclick="() => _filter = FVerification" class="px-4 py-2 rounded-full font-label-sm text-label-sm transition-colors @(_filter == FVerification ? "bg-deep-navy text-paper-white" : "bg-surface-container-low border border-outline-variant text-slate-gray hover:text-deep-navy")">Verifications</button>
        <button @onclick="() => _filter = FApproval" class="px-4 py-2 rounded-full font-label-sm text-label-sm transition-colors @(_filter == FApproval ? "bg-deep-navy text-paper-white" : "bg-surface-container-low border border-outline-variant text-slate-gray hover:text-deep-navy")">Approvals</button>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="w-8 h-8 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else if (!FilteredNotifications.Any())
    {
        <div class="bg-paper-white border border-outline-variant rounded-xl py-16 text-center">
            <span class="material-symbols-outlined text-[48px] text-outline-variant mb-4 block">notifications_none</span>
            <p class="font-body-md text-body-md text-slate-gray">
                @(_filter == FUnread ? "All caught up! No unread notifications." : "No notifications yet.")
            </p>
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var item in FilteredNotifications)
            {
                <button @onclick="() => HandleClick(item)"
                        class="w-full text-left bg-paper-white border border-outline-variant rounded-lg p-4 sm:p-5 hover:bg-surface-container-low transition-colors @(item.IsRead ? "" : "border-l-2 border-l-primary")">
                    <div class="flex items-start gap-4">
                        <div class="shrink-0 w-10 h-10 rounded-full flex items-center justify-center @CategoryBg(item.Category)">
                            <span class="material-symbols-outlined text-[20px] @CategoryIconColor(item.Category)">@CategoryIcon(item.Category)</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-3">
                                <p class="font-label-md text-label-md text-on-surface @(item.IsRead ? "" : "font-semibold")">@item.Title</p>
                                @if (!item.IsRead)
                                {
                                    <span class="w-2.5 h-2.5 rounded-full bg-primary shrink-0 mt-1.5"></span>
                                }
                            </div>
                            <p class="font-body-sm text-body-sm text-slate-gray mt-1">@item.Message</p>
                            <p class="font-body-sm text-[11px] text-outline mt-2">@item.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                        </div>
                    </div>
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _markingAll;
    private string _filter = "all";
    private List<NotificationFeedItem> _notifications = [];

    // Filter constants (avoid Razor quoting issues)
    private const string FAll = "all";
    private const string FUnread = "unread";
    private const string FLowBalance = "low_balance";
    private const string FVerification = "verification_result";
    private const string FApproval = "approval";

    private IEnumerable<NotificationFeedItem> FilteredNotifications => _filter switch
    {
        "unread" => _notifications.Where(n => !n.IsRead),
        "low_balance" or "verification_result" or "approval" or "payment" => _notifications.Where(n => n.Category == _filter),
        _ => _notifications
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _notifications = await Api.GetAsync<List<NotificationFeedItem>>("/v1/notifications") ?? [];
        }
        catch
        {
            _notifications = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleClick(NotificationFeedItem item)
    {
        if (!item.IsRead)
        {
            try
            {
                await Api.PostRawAsync($"/v1/notifications/{item.Id}/read", new { });
                item.IsRead = true;
                item.ReadAt = DateTime.UtcNow;
            }
            catch { }
        }

        if (!string.IsNullOrEmpty(item.ActionUrl))
        {
            Nav.NavigateTo(item.ActionUrl, forceLoad: true);
        }
    }

    private async Task MarkAllRead()
    {
        _markingAll = true;
        try
        {
            await Api.PostRawAsync("/v1/notifications/read-all", new { });
            foreach (var item in _notifications)
            {
                item.IsRead = true;
                item.ReadAt = DateTime.UtcNow;
            }
        }
        catch { }
        finally
        {
            _markingAll = false;
        }
    }

    private static string CategoryIcon(string category) => category switch
    {
        "low_balance" => "account_balance_wallet",
        "verification_result" => "verified",
        "approval" => "check_circle",
        "payment" => "payments",
        "staff_invitation" => "group_add",
        _ => "notifications"
    };

    private static string CategoryIconColor(string category) => category switch
    {
        "low_balance" => "text-error",
        "verification_result" => "text-[#137333]",
        "approval" => "text-warm-gold",
        "payment" => "text-deep-navy",
        "staff_invitation" => "text-primary",
        _ => "text-slate-gray"
    };

    private static string CategoryBg(string category) => category switch
    {
        "low_balance" => "bg-red-50",
        "verification_result" => "bg-green-50",
        "approval" => "bg-yellow-50",
        "payment" => "bg-blue-50",
        "staff_invitation" => "bg-purple-50",
        _ => "bg-surface-container-low"
    };
}
