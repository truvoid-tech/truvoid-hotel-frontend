@page "/reset-password"
@layout OnboardingLayout
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>TruvoID — Set New Password</PageTitle>

<div class="bg-background text-on-background min-h-screen flex items-center justify-center p-margin-mobile md:p-margin-desktop font-body-md">
    <div class="w-full max-w-md">

        <div class="text-center mb-10">
            <div class="flex items-center justify-center gap-3 mb-4">
                <img src="/assets/images/TruvoID-logo.png" alt="TruvoID" class="w-10 h-10 rounded-lg object-contain" />
                <h1 class="font-headline-lg text-headline-lg font-bold text-deep-navy">TruvoID</h1>
            </div>
            <h2 class="font-headline-md text-headline-md text-on-background">Set New Password</h2>
        </div>

        @if (_tokenMissing)
        {
            <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-10 text-center">
                <span class="material-symbols-outlined text-[48px] mb-4 block" style="color:#c5221f; font-variation-settings: 'FILL' 1;">link_off</span>
                <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Invalid Reset Link</h3>
                <p class="font-body-md text-body-md text-slate-gray mb-8">
                    This password reset link is missing or has expired. Please request a new one.
                </p>
                <a href="/forgot-password"
                   class="inline-flex items-center gap-2 bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors">
                    Request New Link
                </a>
            </div>
        }
        else if (_success)
        {
            <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-10 text-center">
                <span class="material-symbols-outlined text-[48px] mb-4 block" style="color:#34a853; font-variation-settings: 'FILL' 1;">lock_reset</span>
                <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Password Updated</h3>
                <p class="font-body-md text-body-md text-slate-gray mb-8">
                    Your password has been changed successfully. You can now sign in with your new credentials.
                </p>
                <a href="/login"
                   class="inline-flex items-center gap-2 bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors">
                    <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    Sign In
                </a>
            </div>
        }
        else
        {
            <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-6 md:p-10 relative">
                <div class="absolute top-0 right-0 w-24 h-1 bg-warm-gold rounded-tr"></div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">
                        <span class="material-symbols-outlined text-[16px] align-middle mr-1">error</span>
                        @_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleReset" class="space-y-6">
                    <div>
                        <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="newPassword">New Password</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">lock</span>
                            <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent pl-10 pr-4 py-3 font-body-md text-body-md text-on-background"
                                   id="newPassword" @bind="_model.NewPassword" type="password" placeholder="********" required />
                        </div>
                        <p class="font-label-sm text-label-sm text-outline mt-1">Must contain uppercase, number, and symbol.</p>
                    </div>

                    <div>
                        <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="confirmPassword">Confirm New Password</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">lock_open</span>
                            <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent pl-10 pr-4 py-3 font-body-md text-body-md text-on-background"
                                   id="confirmPassword" @bind="_model.ConfirmPassword" type="password" placeholder="********" required />
                        </div>
                    </div>

                    <button type="submit" disabled="@_isLoading"
                            class="w-full bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors flex items-center justify-center gap-2 disabled:opacity-50">
                        @if (_isLoading)
                        {
                            <div class="spinner"></div>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Set New Password</span>
                            <span class="material-symbols-outlined text-[18px]">check_circle</span>
                        }
                    </button>
                </EditForm>

                <div class="mt-6 text-center border-t border-surface-container-high pt-5">
                    <a href="/login" class="font-label-sm text-label-sm text-slate-gray hover:text-deep-navy transition-colors uppercase">
                        Back to Sign In
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .spinner {
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top: 2px solid #fff;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .input-bespoke:focus {
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
        outline: none;
    }
</style>

@code {
    private ResetModel _model = new();
    private bool _isLoading;
    private bool _success;
    private bool _tokenMissing;
    private string? _errorMessage;
    private string? _resetToken;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _resetToken = query.TryGetValue("token", out var values) ? values.FirstOrDefault() : null;
        _tokenMissing = string.IsNullOrEmpty(_resetToken);
    }

    private async Task HandleReset()
    {
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "Passwords do not match.";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var raw = await Api.PostRawAsync("/v1/auth/reset-password", new
            {
                token = _resetToken,
                newPassword = _model.NewPassword
            });

            if (raw.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var msg = await ApiClient.GetErrorMessageAsync(raw);
                _errorMessage = string.IsNullOrEmpty(msg)
                    ? "This reset link has expired or is invalid. Please request a new one."
                    : msg;
                return;
            }

            raw.EnsureSuccessStatusCode();
            _success = true;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to connect. Please try again.";
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ResetModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
