@page "/forgot-password"
@layout OnboardingLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>TruvoID — Forgot Password</PageTitle>

<div class="bg-background text-on-background min-h-screen flex items-center justify-center p-margin-mobile md:p-margin-desktop font-body-md">
    <div class="w-full max-w-md">

        <div class="text-center mb-10">
            <div class="flex items-center justify-center gap-3 mb-4">
                <img src="/assets/images/TruvoID-logo.png" alt="TruvoID" class="w-10 h-10 rounded-lg object-contain" />
                <h1 class="font-headline-lg text-headline-lg font-bold text-deep-navy">TruvoID</h1>
            </div>
            <h2 class="font-headline-md text-headline-md text-on-background">Reset Password</h2>
            <p class="font-body-md text-body-md text-slate-gray mt-2">Enter your admin email and we'll send a reset link.</p>
        </div>

        @if (_success)
        {
            <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-10 text-center">
                <span class="material-symbols-outlined text-[48px] mb-4 block" style="color:#34a853; font-variation-settings: 'FILL' 1;">mark_email_read</span>
                <h3 class="font-headline-md text-headline-md text-on-surface mb-2">Check Your Inbox</h3>
                <p class="font-body-md text-body-md text-slate-gray mb-8">
                    If that email is registered with TruvoID, you'll receive a password reset link shortly.
                </p>
                <a href="/login" class="inline-flex items-center gap-2 font-label-md text-label-md text-deep-navy hover:underline uppercase">
                    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                    Back to Sign In
                </a>
            </div>
        }
        else
        {
            <div class="bg-paper-white border border-outline-variant rounded shadow-sm p-6 md:p-10 relative">
                <div class="absolute top-0 right-0 w-24 h-1 bg-warm-gold rounded-tr"></div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">
                        <span class="material-symbols-outlined text-[16px] align-middle mr-1">error</span>
                        @_errorMessage
                    </div>
                }

                <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="space-y-6">
                    <div>
                        <label class="block font-label-sm text-label-sm text-slate-gray mb-1 uppercase" for="email">Admin Email Address</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant pointer-events-none">mail</span>
                            <input class="input-bespoke w-full border border-outline-variant rounded bg-transparent pl-10 pr-4 py-3 font-body-md text-body-md text-on-background"
                                   id="email" @bind="_model.Email" type="email" placeholder="admin@institution.com" required />
                        </div>
                    </div>

                    <button type="submit" disabled="@_isLoading"
                            class="w-full bg-deep-navy text-paper-white font-label-md text-label-md uppercase px-6 py-3 rounded hover:bg-ink transition-colors flex items-center justify-center gap-2 disabled:opacity-50">
                        @if (_isLoading)
                        {
                            <div class="spinner"></div>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send Reset Link</span>
                            <span class="material-symbols-outlined text-[18px]">send</span>
                        }
                    </button>
                </EditForm>

                <div class="mt-6 text-center border-t border-surface-container-high pt-5">
                    <a href="/login" class="font-label-sm text-label-sm text-slate-gray hover:text-deep-navy transition-colors uppercase">
                        Back to Sign In
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .spinner {
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 50%;
        border-top: 2px solid #fff;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .input-bespoke:focus {
        border-color: #1f3864;
        box-shadow: inset 0 0 0 1px #1f3864;
        outline: none;
    }
</style>

@code {
    private ForgotModel _model = new();
    private bool _isLoading;
    private bool _success;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            await Api.PostRawAsync("/v1/auth/forgot-password", new { email = _model.Email });
            // Always show success regardless of whether the email exists (security best practice)
            _success = true;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Unable to connect. Please try again.";
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
