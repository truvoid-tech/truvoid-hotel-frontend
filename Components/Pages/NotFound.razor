@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<PageTitle>404 — TruvoID</PageTitle>

<div class="min-h-screen flex flex-col items-center justify-center px-6 py-16 bg-background text-on-background text-center">
    <img src="/assets/images/TruvoID-logo.png" alt="TruvoID" class="w-12 h-12 rounded-xl object-contain mb-8 opacity-80" />
    <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-widest mb-4">Error 404</p>
    <h1 class="font-headline-lg text-headline-lg md:font-display-sm md:text-display-sm text-deep-navy mb-4">Page not found</h1>
    <p class="font-body-md text-body-md text-slate-gray max-w-md mb-10">
        The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
        <button @onclick='() => Nav.NavigateTo("/dashboard")'
                class="px-8 py-3 bg-deep-navy text-paper-white font-label-md text-label-md uppercase rounded hover:bg-ink transition-colors">
            Go to Dashboard
        </button>
        <button @onclick='() => Nav.NavigateTo("/login")'
                class="px-8 py-3 border-[1.5px] border-deep-navy text-deep-navy font-label-md text-label-md uppercase rounded hover:bg-surface-container-low transition-colors">
            Sign In
        </button>
    </div>
</div>
