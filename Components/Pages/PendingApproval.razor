@page "/pending-approval"
@layout OnboardingLayout
@rendermode InteractiveServer
@implements IDisposable
@inject TokenService TokenService
@inject NavigationManager Nav

<PageTitle>TruvoID — Awaiting Approval</PageTitle>

<div class="min-h-screen bg-background flex flex-col items-center justify-center px-margin-mobile md:px-margin-desktop py-12">

    <!-- Logo -->
    <div class="flex items-center gap-3 mb-12">
        <img src="/assets/images/TruvoID-logo.png" alt="TruvoID" class="w-10 h-10 rounded-xl object-contain" />
        <span class="font-headline-md text-headline-md text-deep-navy font-bold">TruvoID</span>
    </div>

    <div class="w-full max-w-lg bg-paper-white border border-outline-variant rounded shadow-sm overflow-hidden">
        <div class="h-1 w-full bg-warm-gold"></div>

        <div class="p-8 md:p-12 flex flex-col items-center text-center gap-6">

            <!-- Icon -->
            <div class="w-20 h-20 rounded-full bg-[#fef7e0] border border-[#fde083] flex items-center justify-center">
                <span class="material-symbols-outlined text-[#b06000] text-[40px]" style="font-variation-settings: 'FILL' 1;">pending_actions</span>
            </div>

            <div>
                <h1 class="font-headline-lg text-headline-lg text-on-surface mb-3">Application Under Review</h1>
                <p class="font-body-md text-body-md text-slate-gray leading-relaxed">
                    Your institution has been registered and your compliance documents are under review by the TruvoID team. You'll receive an email notification once your account is approved.
                </p>
            </div>

            <!-- What happens next -->
            <div class="w-full border border-outline-variant rounded p-5 text-left flex flex-col gap-4">
                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">What happens next</p>

                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-deep-navy flex items-center justify-center shrink-0 mt-0.5">
                        <span class="font-label-sm text-label-sm text-white">1</span>
                    </div>
                    <div>
                        <p class="font-label-md text-label-md text-on-surface">Document verification</p>
                        <p class="font-body-sm text-[12px] text-slate-gray">We verify your CAC certificate and business details against the CAC registry.</p>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-deep-navy flex items-center justify-center shrink-0 mt-0.5">
                        <span class="font-label-sm text-label-sm text-white">2</span>
                    </div>
                    <div>
                        <p class="font-label-md text-label-md text-on-surface">Compliance review</p>
                        <p class="font-body-sm text-[12px] text-slate-gray">Your declared use case and business type are reviewed for NIMC authorization eligibility.</p>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <div class="w-6 h-6 rounded-full bg-surface-container-low border border-outline-variant flex items-center justify-center shrink-0 mt-0.5">
                        <span class="font-label-sm text-label-sm text-slate-gray">3</span>
                    </div>
                    <div>
                        <p class="font-label-md text-label-md text-slate-gray">Account activation</p>
                        <p class="font-body-sm text-[12px] text-slate-gray">You'll receive an email with your activation confirmation and access instructions.</p>
                    </div>
                </div>
            </div>

            <!-- Timeline note -->
            <div class="flex items-center gap-2 text-[#b06000]">
                <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">schedule</span>
                <span class="font-label-sm text-label-sm">Typical review time: 1 – 2 business days</span>
            </div>

            <!-- Actions -->
            <div class="w-full flex flex-col gap-3 pt-2 border-t border-outline-variant">
                <button @onclick="CheckApproval"
                        class="w-full flex items-center justify-center gap-2 bg-deep-navy text-paper-white font-label-md text-label-md uppercase py-3 rounded hover:bg-ink transition-colors">
                    @if (_checking)
                    {
                        <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Checking...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">refresh</span>
                        <span>Check Approval Status</span>
                    }
                </button>
                <button @onclick="Logout" class="w-full font-label-sm text-label-sm text-slate-gray hover:text-on-surface uppercase tracking-wider py-2 transition-colors">
                    Sign out
                </button>
            </div>

            @if (_statusMessage != null)
            {
                <p class="font-body-sm text-body-sm text-slate-gray">@_statusMessage</p>
            }
        </div>
    </div>
</div>

@code {
    private bool _checking;
    private string? _statusMessage;
    private System.Threading.Timer? _pollTimer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _pollTimer = new System.Threading.Timer(_ => InvokeAsync(PollApproval), null,
            TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task PollApproval()
    {
        try
        {
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
        catch { }
    }

    private async Task CheckApproval()
    {
        _checking = true;
        _statusMessage = null;
        StateHasChanged();
        try
        {
            await Task.Delay(400);
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task Logout()
    {
        _pollTimer?.Dispose();
        await TokenService.ClearTokensAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
