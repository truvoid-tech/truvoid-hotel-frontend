@rendermode InteractiveServer
@inject ApiClient Api

<div class="relative" @onclick:stopPropagation>
    <!-- Bell Icon -->
    <button @onclick="ToggleDropdown" class="relative p-2 rounded-full hover:bg-surface-container-low transition-colors">
        <span class="material-symbols-outlined text-[20px] @(HasUnread ? "text-warm-gold" : "")">notifications</span>
        @if (UnreadCount > 0)
        {
            <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] flex items-center justify-center bg-error text-on-error text-[10px] font-bold rounded-full px-1">
                @(UnreadCount > 99 ? "99+" : UnreadCount.ToString())
            </span>
        }
    </button>

    <!-- Dropdown -->
    @if (_open)
    {
        <!-- Backdrop -->
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <div class="absolute right-0 top-full mt-2 w-80 sm:w-96 bg-paper-white border border-outline-variant rounded-lg shadow-lg z-50 overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-outline-variant">
                <h3 class="font-label-md text-label-md text-on-surface">Notifications</h3>
                @if (UnreadCount > 0)
                {
                    <button @onclick="MarkAllRead" class="font-label-sm text-label-sm text-primary hover:text-deep-navy transition-colors">
                        Mark all read
                    </button>
                }
            </div>

            <!-- Notification List -->
            <div class="max-h-[400px] overflow-y-auto">
                @if (_loading)
                {
                    <div class="flex items-center justify-center py-8">
                        <div class="w-6 h-6 border-2 border-deep-navy border-t-transparent rounded-full animate-spin"></div>
                    </div>
                }
                else if (_notifications.Count == 0)
                {
                    <div class="py-8 text-center">
                        <span class="material-symbols-outlined text-[32px] text-outline-variant mb-2 block">notifications_none</span>
                        <p class="font-body-sm text-body-sm text-slate-gray">No notifications yet</p>
                    </div>
                }
                else
                {
                    @foreach (var item in _notifications.Take(15))
                    {
                        <button @onclick="() => HandleClick(item)"
                                class="w-full text-left px-4 py-3 border-b border-outline-variant/50 hover:bg-surface-container-low transition-colors @(item.IsRead ? "" : "bg-primary/5")">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-[18px] mt-0.5 @CategoryIconColor(item.Category)">@CategoryIcon(item.Category)</span>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <p class="font-label-sm text-label-sm text-on-surface truncate @(item.IsRead ? "" : "font-semibold")">@item.Title</p>
                                        @if (!item.IsRead)
                                        {
                                            <span class="w-2 h-2 rounded-full bg-primary shrink-0"></span>
                                        }
                                    </div>
                                    <p class="font-body-sm text-[12px] text-slate-gray mt-0.5 line-clamp-2">@item.Message</p>
                                    <p class="font-body-sm text-[10px] text-outline mt-1">@FormatTimeAgo(item.CreatedAt)</p>
                                </div>
                            </div>
                        </button>
                    }
                }
            </div>

            <!-- Footer -->
            @if (_notifications.Count > 0)
            {
                <div class="px-4 py-2.5 border-t border-outline-variant text-center">
                    <a href="/notifications" @onclick="CloseDropdown" class="font-label-sm text-label-sm text-primary hover:text-deep-navy transition-colors">
                        View all notifications
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _open;
    private bool _loading;
    private List<NotificationFeedItem> _notifications = [];

    private int UnreadCount => _notifications.Count(n => !n.IsRead);
    private bool HasUnread => UnreadCount > 0;

    private void ToggleDropdown()
    {
        _open = !_open;
        if (_open) _ = LoadNotifications();
    }

    private void CloseDropdown() => _open = false;

    private async Task LoadNotifications()
    {
        _loading = true;
        try
        {
            _notifications = await Api.GetAsync<List<NotificationFeedItem>>("/v1/notifications") ?? [];
        }
        catch
        {
            _notifications = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleClick(NotificationFeedItem item)
    {
        if (!item.IsRead)
        {
            try
            {
                await Api.PostRawAsync($"/v1/notifications/{item.Id}/read", new { });
                item.IsRead = true;
                item.ReadAt = DateTime.UtcNow;
            }
            catch { }
        }

        CloseDropdown();

        if (!string.IsNullOrEmpty(item.ActionUrl))
        {
            NavigationManager.NavigateTo(item.ActionUrl, forceLoad: true);
        }
    }

    private async Task MarkAllRead()
    {
        try
        {
            await Api.PostRawAsync("/v1/notifications/read-all", new { });
            foreach (var item in _notifications)
            {
                item.IsRead = true;
                item.ReadAt = DateTime.UtcNow;
            }
        }
        catch { }
    }

    private static string FormatTimeAgo(DateTime date)
    {
        var span = DateTime.UtcNow - date;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return date.ToString("dd MMM yyyy");
    }

    private static string CategoryIcon(string category) => category switch
    {
        "low_balance" => "account_balance_wallet",
        "verification_result" => "verified",
        "approval" => "check_circle",
        "payment" => "payments",
        "staff_invitation" => "group_add",
        _ => "notifications"
    };

    private static string CategoryIconColor(string category) => category switch
    {
        "low_balance" => "text-error",
        "verification_result" => "text-[#137333]",
        "approval" => "text-warm-gold",
        "payment" => "text-deep-navy",
        "staff_invitation" => "text-primary",
        _ => "text-slate-gray"
    };

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}
