@rendermode InteractiveServer
@inject TokenService TokenService
@inject TruvoIDAuthStateProvider AuthState
@inject NavigationManager Nav

<button @onclick="HandleLogout" class="@CssClass">
    <span class="material-symbols-outlined text-[18px]">logout</span>
    @Label
</button>

@code {
    [Parameter] public string CssClass { get; set; } = "w-full flex items-center justify-center gap-2 py-3 rounded transition-colors";
    [Parameter] public string Label { get; set; } = "Sign Out";

    private async Task HandleLogout()
    {
        await TokenService.ClearTokensAsync();
        AuthState.NotifyAuthenticationStateChanged();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
