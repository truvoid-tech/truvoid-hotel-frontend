@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="bg-background text-on-surface font-body-md min-h-screen flex flex-col md:flex-row antialiased selection:bg-deep-navy selection:text-paper-white">

    <!-- Mobile Top Nav -->
    <header class="md:hidden flex justify-between items-center w-full px-margin-mobile h-16 bg-ink border-b border-white/10 shrink-0">
        <div class="flex items-center gap-2">
            <img src="/assets/images/TruvoID-logo.png" alt="TruvoID" class="w-8 h-8 rounded-md object-contain" />
            <div class="flex flex-col leading-none">
                <span class="font-headline-md text-headline-md font-bold text-paper-white">TruvoID</span>
                <span class="text-[9px] font-label-sm text-warm-gold uppercase tracking-widest">Platform Admin</span>
            </div>
        </div>
        <div class="flex items-center gap-4 text-paper-white/60">
            <span class="material-symbols-outlined cursor-pointer hover:text-warm-gold transition-colors">notifications</span>
            <div class="w-8 h-8 rounded-full bg-white/10 border border-white/20 flex items-center justify-center">
                <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
            </div>
        </div>
    </header>

    <!-- Desktop Sidebar -->
    <nav class="hidden md:flex flex-col h-screen w-64 py-unit gap-2 shrink-0 sticky top-0" style="background-color: #0a1628;">

        <!-- Brand + Badge -->
        <div class="px-6 py-6 mb-2">
            <div class="flex items-center gap-3 mb-3">
                <img src="/assets/images/TruvoID-logo.png" alt="TruvoID" class="w-10 h-10 rounded-lg object-contain" />
                <span class="font-headline-md text-headline-md text-paper-white leading-tight">TruvoID</span>
            </div>
            <div class="inline-flex items-center gap-1.5 bg-warm-gold/15 border border-warm-gold/40 rounded px-2.5 py-1">
                <span class="material-symbols-outlined text-warm-gold text-[14px]" style="font-variation-settings: 'FILL' 1;">admin_panel_settings</span>
                <span class="font-label-sm text-label-sm text-warm-gold uppercase tracking-widest">Platform Admin</span>
            </div>
        </div>

        <!-- Nav Items -->
        <div class="flex-1 flex flex-col gap-1 px-4">
            <a href="/admin" class="@(SideNavClass("/admin", exact: true))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/admin", exact: true))">dashboard</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Overview</span>
            </a>
            <a href="/admin/institutions" class="@(SideNavClass("/admin/institutions"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/admin/institutions"))">corporate_fare</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Institutions</span>
            </a>
            <a href="/admin/financials" class="@(SideNavClass("/admin/financials"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/admin/financials"))">payments</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Financials</span>
            </a>
            <a href="/admin/pricing" class="@(SideNavClass("/admin/pricing"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/admin/pricing"))">price_change</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Pricing</span>
            </a>
            <a href="/admin/api-audit" class="@(SideNavClass("/admin/api-audit"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/admin/api-audit"))">key</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">API Audit</span>
            </a>
            <a href="/admin/nimc" class="@(SideNavClass("/admin/nimc"))">
                <span class="material-symbols-outlined" style="@(ActiveFill("/admin/nimc"))">vpn_key</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">NIMC Config</span>
            </a>

            <!-- Divider -->
            <div class="my-3 border-t border-white/10"></div>

            <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-on-primary/40 hover:text-on-primary/70 cursor-pointer hover:bg-white/5 transition-all duration-200 border-l-4 border-transparent rounded-r-DEFAULT">
                <span class="material-symbols-outlined">open_in_new</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Institution View</span>
            </a>
        </div>

        <!-- Bottom: Admin user + Logout -->
        <div class="px-6 py-4 mt-auto border-t border-white/10 flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-warm-gold/20 border border-warm-gold/40 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-warm-gold text-[16px]">person</span>
                </div>
                <div class="flex flex-col leading-none min-w-0">
                    <span class="font-label-sm text-label-sm text-paper-white uppercase truncate">TruvoID Admin</span>
                    <span class="text-[10px] text-paper-white/40 mt-0.5">Platform Operations</span>
                </div>
            </div>
            <LogoutButton CssClass="w-full flex items-center justify-center gap-2 py-2.5 border border-white/20 rounded text-on-primary/60 hover:text-paper-white hover:bg-white/10 transition-colors font-label-sm text-label-sm uppercase tracking-wider" Label="Sign Out" />
        </div>
    </nav>

    <!-- Main Content Canvas -->
    <main class="flex-1 flex flex-col min-w-0 bg-background relative overflow-y-auto">

        <!-- Desktop Top Bar -->
        <header class="hidden md:flex justify-between items-center w-full px-margin-desktop h-16 bg-surface border-b border-outline-variant shrink-0 sticky top-0 z-10">
            <div class="flex items-center gap-3">
                <span class="font-body-sm text-body-sm text-slate-gray">Platform Operations</span>
                <span class="font-body-sm text-body-sm text-outline-variant">/</span>
                <span class="font-label-sm text-label-sm text-deep-navy uppercase tracking-wider">@CurrentSection</span>
            </div>
            <div class="flex items-center gap-5">
                <button class="text-slate-gray hover:text-deep-navy transition-colors">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <div class="h-8 w-px bg-outline-variant"></div>
                <div class="flex items-center gap-2">
                    <div class="flex flex-col items-end leading-none">
                        <span class="font-label-sm text-label-sm text-deep-navy uppercase">TruvoID Admin</span>
                        <span class="text-[10px] text-slate-gray mt-0.5">Platform Admin</span>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-surface-container border border-outline-variant flex items-center justify-center">
                        <span class="material-symbols-outlined text-slate-gray text-[18px]">admin_panel_settings</span>
                    </div>
                </div>
            </div>
        </header>

        @Body

        <!-- Footer -->
        <footer class="mt-auto border-t border-outline-variant bg-surface-container-low px-margin-mobile md:px-margin-desktop py-4">
            <div class="flex items-center justify-between">
                <span class="font-label-sm text-[10px] text-slate-gray opacity-60">TruvoID Platform Admin — Internal Use Only. Unauthorized access is prohibited.</span>
                <span class="font-label-sm text-label-sm text-slate-gray opacity-60">V 2.4.1</span>
            </div>
        </footer>
    </main>

    <!-- Mobile Bottom Nav -->
    <nav class="md:hidden flex justify-around items-center w-full h-16 bg-ink border-t border-white/10 shrink-0 fixed bottom-0 left-0 z-50">
        <a href="/admin" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/admin", exact: true) ? "text-warm-gold border-t-2 border-warm-gold" : "text-paper-white/50 hover:text-paper-white")">
            <span class="material-symbols-outlined text-[20px]" style="@(ActiveFill("/admin", exact: true))">dashboard</span>
            <span class="text-[9px] font-label-sm mt-0.5">Overview</span>
        </a>
        <a href="/admin/institutions" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/admin/institutions") ? "text-warm-gold border-t-2 border-warm-gold" : "text-paper-white/50 hover:text-paper-white")">
            <span class="material-symbols-outlined text-[20px]">corporate_fare</span>
            <span class="text-[9px] font-label-sm mt-0.5">Institutions</span>
        </a>
        <a href="/admin/financials" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/admin/financials") ? "text-warm-gold border-t-2 border-warm-gold" : "text-paper-white/50 hover:text-paper-white")">
            <span class="material-symbols-outlined text-[20px]">payments</span>
            <span class="text-[9px] font-label-sm mt-0.5">Financials</span>
        </a>
        <a href="/admin/pricing" class="flex flex-col items-center justify-center w-full h-full @(IsActive("/admin/pricing") ? "text-warm-gold border-t-2 border-warm-gold" : "text-paper-white/50 hover:text-paper-white")">
            <span class="material-symbols-outlined text-[20px]">price_change</span>
            <span class="text-[9px] font-label-sm mt-0.5">Pricing</span>
        </a>
    </nav>
    <div class="h-16 md:hidden w-full shrink-0"></div>
</div>

@code {
    private bool IsActive(string prefix, bool exact = false)
    {
        var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return exact
            ? path.Equals(prefix, StringComparison.OrdinalIgnoreCase)
            : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    }

    private string ActiveFill(string prefix, bool exact = false) =>
        IsActive(prefix, exact) ? "font-variation-settings: 'FILL' 1;" : "";

    private string SideNavClass(string prefix, bool exact = false) => IsActive(prefix, exact)
        ? "flex items-center gap-3 px-4 py-3 text-warm-gold font-bold bg-white/5 border-l-4 border-warm-gold rounded-r-DEFAULT cursor-pointer hover:bg-white/10 transition-all duration-200"
        : "flex items-center gap-3 px-4 py-3 text-on-primary/60 hover:text-on-primary cursor-pointer hover:bg-white/10 transition-all duration-200 border-l-4 border-transparent rounded-r-DEFAULT";

    private string CurrentSection
    {
        get
        {
            var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            if (path.Equals("/admin", StringComparison.OrdinalIgnoreCase)) return "Overview";
            if (path.StartsWith("/admin/institutions")) return "Institutions";
            if (path.StartsWith("/admin/financials")) return "Financials";
            if (path.StartsWith("/admin/pricing")) return "Pricing";
            if (path.StartsWith("/admin/api-audit")) return "API Audit";
            return "Admin";
        }
    }

}
