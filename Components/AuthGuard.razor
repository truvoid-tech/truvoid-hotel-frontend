@rendermode InteractiveServer
@inject TokenService TokenService
@inject ApiClient Api
@inject NavigationManager Nav

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var token = await TokenService.GetAccessTokenAsync();
        if (string.IsNullOrEmpty(token) || await TokenService.IsTokenExpiredAsync())
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        // Confirm the session is still valid server-side, not just unexpired
        // locally — catches revoked/suspended accounts immediately rather than
        // waiting for the first data call to fail.
        try
        {
            var profile = await Api.GetAsync<AuthProfile>("/v1/auth/me");
            if (profile is null)
                Nav.NavigateTo("/login", forceLoad: false);
        }
        catch
        {
            // Transient network/server error — don't force logout for a blip.
        }
    }
}
