@rendermode InteractiveServer
@inject TokenService TokenService
@inject ApiClient Api
@inject NavigationManager Nav

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var token = await TokenService.GetAccessTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        // Role comes from the server response, not the locally-parsed JWT —
        // the client never verifies the token's signature, so trusting a
        // claim read straight out of localStorage would let a forged token
        // grant itself the PlatformAdmin UI. GET /v1/auth/me returns the
        // role the backend actually thinks this token holds.
        AuthProfile? profile;
        try
        {
            profile = await Api.GetAsync<AuthProfile>("/v1/auth/me");
        }
        catch
        {
            return; // transient error — don't kick the user out
        }

        if (profile is null)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (profile.Role != AuthRole.PlatformAdmin)
        {
            Nav.NavigateTo("/dashboard", forceLoad: false);
        }
    }
}
