@rendermode InteractiveServer
@using TruvoID.Components.Services
@inject ToastService ToastService
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="fixed bottom-6 right-6 z-[9999] flex flex-col gap-3 max-w-sm w-full">
        @foreach (var toast in _toasts)
        {
            <div class="flex items-start gap-3 px-4 py-3 rounded-lg shadow-lg border text-sm font-medium animate-slide-in
                        @(toast.Type switch {
                            ToastType.Success => "bg-green-50 border-green-200 text-green-800",
                            ToastType.Error   => "bg-red-50 border-red-200 text-red-800",
                            ToastType.Warning => "bg-yellow-50 border-yellow-200 text-yellow-800",
                            _                 => "bg-blue-50 border-blue-200 text-blue-800"
                        })">
                <span class="material-symbols-outlined text-[18px] shrink-0 mt-0.5"
                      style="font-variation-settings: 'FILL' 1;">
                    @(toast.Type switch {
                        ToastType.Success => "check_circle",
                        ToastType.Error   => "error",
                        ToastType.Warning => "warning",
                        _                 => "info"
                    })
                </span>
                <span class="flex-1">@toast.Message</span>
                <button @onclick="() => Remove(toast.Id)" class="shrink-0 opacity-60 hover:opacity-100 transition-opacity">
                    <span class="material-symbols-outlined text-[16px]">close</span>
                </button>
            </div>
        }
    </div>
}

<style>
    @@keyframes slide-in {
        from { opacity: 0; transform: translateX(100%); }
        to   { opacity: 1; transform: translateX(0); }
    }
    .animate-slide-in { animation: slide-in 0.25s ease-out; }
</style>

@code {
    private readonly List<Toast> _toasts = new();

    protected override void OnInitialized()
        => ToastService.OnShow += OnToastReceived;

    private void OnToastReceived(Toast toast)
    {
        _toasts.Add(toast);
        InvokeAsync(StateHasChanged);
        _ = AutoRemove(toast.Id);
    }

    private async Task AutoRemove(string id)
    {
        await Task.Delay(4000);
        Remove(id);
    }

    private void Remove(string id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => ToastService.OnShow -= OnToastReceived;
}
