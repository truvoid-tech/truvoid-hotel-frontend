@inherits ErrorBoundaryBase

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="min-h-[400px] flex flex-col items-center justify-center p-8 text-center">
        <span class="material-symbols-outlined text-outline-variant mb-4" style="font-size:48px;">error</span>
        <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Something went wrong</h2>
        <p class="font-body-md text-body-md text-slate-gray mb-6 max-w-md">An unexpected error occurred. Please try refreshing the page.</p>
        <button @onclick="Recover"
                class="px-6 py-3 bg-deep-navy text-paper-white font-label-md text-label-md uppercase rounded hover:bg-ink transition-colors">
            Try Again
        </button>
    </div>
}

@code {
    protected override Task OnErrorAsync(Exception exception)
    {
        Console.Error.WriteLine($"[AppErrorBoundary] {exception}");
        return Task.CompletedTask;
    }
}
